{
  translations: [],
  words: [],
  current: 0,
  init(){
    document.querySelectorAll('span[i]').forEach(span => {
      const key = span.getAttribute('i');
  span.addEventListener('click', event => {
          fetch('/words/static/'+key +'.json').then((response)=>
            response.json()
          ).then((data)=>{
            this.translations = data.translation;
          })
    });
    });
  },
}
" id="content">
<div x-effect="$el.innerHTML = translations.join('<br>')" id="definition"></div></div>
